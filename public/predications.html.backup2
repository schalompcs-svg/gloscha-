<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Prédications - GPIAN</title>
  <link rel="stylesheet" href="style.css">

  <style>
    .pred-container {
      max-width: 1000px;
      margin: 30px auto;
      padding: 20px;
    }

    .pred-card {
      background: #fff;
      border-radius: 18px;
      padding: 25px;
      margin-bottom: 25px;
      box-shadow: 0 4px 18px rgba(0,0,0,.08);
    }

    .pred-card h2 {
      margin-top: 0;
    }

    .pred-text {
      white-space: pre-wrap;
      line-height: 1.8;
      font-size: 17px;
    }

    .pred-date {
      opacity: .7;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .pred-photos {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-top: 20px;
    }

    .pred-photos img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 12px;
      display: block;
    }

    /* ADMINISTRATION CACHÉE */
    #jesus-admin {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 999999;
      background: #fff;
      overflow-y: auto;
      padding: 20px;
    }

    .admin-box {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      padding-bottom: 40px;
    }

    .admin-box h1 {
      margin-top: 10px;
    }

    .admin-box input[type="text"],
    .admin-box textarea {
      width: 100%;
      box-sizing: border-box;
      border: 1px solid #ccc;
      border-radius: 12px;
      padding: 15px;
      font-size: 16px;
      margin-top: 12px;
      font-family: inherit;
    }

    .admin-box textarea {
      min-height: 520px;
      resize: vertical;
      line-height: 1.6;
    }

    .photo-label {
      display: block;
      margin-top: 18px;
      font-weight: bold;
    }

    #pred-photos {
      width: 100%;
      margin-top: 10px;
      padding: 12px;
      box-sizing: border-box;
      border: 1px solid #ccc;
      border-radius: 12px;
      background: #fff;
    }

    #photo-preview {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 10px;
      margin-top: 15px;
    }

    #photo-preview img {
      width: 100%;
      height: 130px;
      object-fit: cover;
      border-radius: 10px;
    }

    .admin-button {
      width: 100%;
      padding: 15px;
      border: 0;
      border-radius: 12px;
      margin-top: 12px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      background: #111;
      color: #fff;
    }

    .admin-close {
      background: #b00020;
    }

    .admin-clear {
      background: #555;
    }

    #admin-status {
      margin-top: 15px;
      padding: 12px;
      border-radius: 10px;
      font-weight: bold;
    }

    .empty-message {
      text-align: center;
      padding: 30px 10px;
      opacity: .75;
    }
  </style>
</head>

<body>

  <header>
    <h1>Prédications</h1>
  </header>

  <main class="pred-container">
    <div id="publications">
      <div class="pred-card empty-message">
        <h2>Prédications</h2>
        <p>Les prédications publiées apparaîtront ici.</p>
      </div>
    </div>
  </main>

  <!-- ESPACE TOTALLEMENT CACHÉ -->
  <section id="jesus-admin" aria-hidden="true">
    <div class="admin-box">

      <h1>Administration des prédications</h1>

      <p>
        Importation et publication des prédications.
      </p>

      <input
